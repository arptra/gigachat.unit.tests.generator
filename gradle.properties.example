# Copy this file to your project's gradle.properties and adjust values.
# Launch task: ./gradlew genAiTest or ./gradlew diffGenUnitTest

# Path to project that should be scanned/generate tests for (optional).
# If empty, current project directory is used.
# gigachat.path=./example-project

# Scanner filters (optional)
# Comma-separated module names, e.g. app,service
gigachat.includeModules=
# Comma-separated class include filters
gigachat.includeClasses=
# Comma-separated target classes/FQCNs
# Example: com.example.service.UserService,com.example.lib.LibraryComponent
gigachat.class=

# Pipeline toggles
gigachat.project=true
gigachat.singleFile=false
gigachat.parallel=false
gigachat.compile=false
gigachat.execute=false
gigachat.coverage=false
# Comma-separated staged goals, for example 40,60,80,100
gigachat.coverageGoals=
# Optional single-goal alias
gigachat.coverageThreshold=

# Diff mode branches (optional)
# If not set: source=current branch, target=master
gigachat.sourceBranch=
gigachat.targetBranch=

# GigaChat auth (optional)
# Token mode
# gigachat.token is treated as the OAuth authorization key used by GigaChatTokenClient.
# gigachat.authUrl is optional for the standard public endpoint.
gigachat.token=
gigachat.endpoint=
gigachat.authUrl=
# mTLS mode
gigachat.cert=
gigachat.rootCert=
gigachat.key=

# Optional connection/model flags
gigachat.ssl=false
# Enable unauthenticated HTTP proxy LLM client
gigachat.proxy=false
gigachat.model=
